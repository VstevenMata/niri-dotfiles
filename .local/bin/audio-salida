#!/usr/bin/env bash
# Selector de salida de audio (fuzzel).
# Las bocinas y los audífonos de la laptop están en perfiles distintos de la
# tarjeta (UCM de SOF), así que al elegirlos hay que cambiar el perfil primero.
set -uo pipefail

CARD=alsa_card.pci-0000_00_1f.3-platform-skl_hda_dsp_generic
PREFIX=alsa_output.pci-0000_00_1f.3-platform-skl_hda_dsp_generic.HiFi__
PERFIL_BOCINAS="HiFi (HDMI1, HDMI2, HDMI3, Mic1, Mic2, Speaker)"
PERFIL_AUDIFONOS="HiFi (HDMI1, HDMI2, HDMI3, Headphones, Mic1, Mic2)"

# Monitores HDMI/DP con audio conectados (el nick es el nombre del monitor)
opciones=()
while IFS=$'\t' read -r port nick; do
    if [[ $port == =* ]]; then opciones+=("$nick	$port"); else opciones+=("Monitor $nick	$port"); fi
done < <(pactl -f json list sinks 2>/dev/null | python3 -c '
import json, sys
for s in json.load(sys.stdin):
    p = s["properties"]; nick = p.get("node.nick", "")
    port = s["name"].removeprefix("'"$PREFIX"'").removesuffix("__sink")
    if not s["name"].startswith("'"$PREFIX"'"):
        # USB / Bluetooth: se elige por nombre completo del sink
        print("=" + s["name"] + "\t" + (nick or s["name"]))
    elif port.startswith("HDMI") and not nick.startswith("HDMI "):
        print(port + "\t" + nick)
')
opciones+=("Bocinas de la laptop	Speaker")
amixer -c sofhdadsp cget name='Headphone Jack' 2>/dev/null | grep -q 'values=on' \
    && opciones+=("Audífonos (jack)	Headphones")

actual=$(pactl get-default-sink)
if [[ $actual == "$PREFIX"* ]]; then actual=${actual#"$PREFIX"}; actual=${actual%__sink}; else actual="=$actual"; fi
# Ícono de cada opción según el tipo de dispositivo
icono() {
    case $1 in
        # El video-display de WhiteSur parece una terminal; se usa el de Adwaita
        HDMI*)           f=/usr/share/icons/Adwaita/scalable/devices/video-display.svg
                         [[ -f $f ]] && echo "$f" || echo video-display ;;
        Speaker)         echo audio-speakers ;;
        Headphones)      echo audio-headphones ;;
        =bluez_output.*) echo bluetooth ;;
        *)               echo audio-headphones ;;
    esac
}

# Entradas para fuzzel: "texto\0icon\x1fnombre-ícono" (se imprime directo porque
# bash no puede guardar \0 en variables)
sel=0
for i in "${!opciones[@]}"; do [[ ${opciones[$i]#*$'\t'} == "$actual" ]] && sel=$i; done
entradas() {
    for i in "${!opciones[@]}"; do
        local o=${opciones[$i]} label
        label=${o%%$'\t'*}; (( i == sel )) && label+="   ✓"
        printf '%s\0icon\x1f%s\n' "$label" "$(icono "${o#*$'\t'}")"
    done
}

idx=$(entradas | fuzzel --dmenu --index \
        --config "$HOME/.config/fuzzel/audio-salida.ini" \
        --mesg "Salida de audio" --select-index "$sel" \
        --lines "${#opciones[@]}") || exit 0
[[ $idx =~ ^[0-9]+$ ]] || exit 0

o=${opciones[$idx]}
eleccion=${o%%$'\t'*}
port=${o#*$'\t'}
case $port in
    Speaker)    pactl set-card-profile "$CARD" "$PERFIL_BOCINAS" ;;
    Headphones) pactl set-card-profile "$CARD" "$PERFIL_AUDIFONOS" ;;
esac
if [[ $port == =* ]]; then sink=${port#=}; else sink="$PREFIX${port}__sink"; fi
# Audífonos/DAC USB que arrancan en el perfil digital (IEC958) no suenan:
# pasar su tarjeta al perfil analógico.
if [[ $sink == alsa_output.usb-*.iec958-* ]]; then
    dev=${sink#alsa_output.}; dev=${dev%.iec958-*}
    pactl set-card-profile "alsa_card.$dev" "output:analog-stereo+input:analog-stereo" 2>/dev/null \
        || pactl set-card-profile "alsa_card.$dev" "output:analog-stereo"
    sink="alsa_output.$dev.analog-stereo"
fi
for _ in $(seq 20); do pactl list short sinks | grep -q "$sink" && break; sleep 0.1; done
pactl set-default-sink "$sink"
for input in $(pactl list short sink-inputs | cut -f1); do
    pactl move-sink-input "$input" "$sink" 2>/dev/null
done
notify-send -a "Audio" -i "$(icono "$port")" "Salida de audio" "$eleccion" 2>/dev/null
