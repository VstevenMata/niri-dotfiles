#!/usr/bin/env bash
# theme start — modo zen (único modo). Lo usa niri al iniciar sesión: espera a DMS y aplica
# fondo, no molestar, luz cálida, iconos y cursor. La barra/colores viven en settings.json de DMS.
set -euo pipefail
for _ in $(seq 60); do dms ipc call theme getMode >/dev/null 2>&1 && break; sleep 0.5; done

WP=$(cat ~/.local/state/theme-wallpaper-zen 2>/dev/null || true)
[ -f "$WP" ] || WP=~/Pictures/Wallpapers/zen-bosque-desde-abajo.jpg
dms ipc call wallpaper set "$WP" >/dev/null
dms ipc call notifications enableDoNotDisturbIndefinitely >/dev/null
dms ipc call night enable >/dev/null
gsettings set org.gnome.desktop.interface icon-theme Tela-black-dark
gsettings set org.gnome.desktop.interface cursor-theme Bibata-Modern-Classic

# El reloj zen cuenta desde el inicio de sesión; el pomodoro arranca de cero si lo dejaste activado
date +%s > ~/.local/state/theme-zen-since
F=~/.local/state/zen-focus-since
[ "$(cat $F 2>/dev/null || echo 1)" != 0 ] && date +%s > $F
echo zen > ~/.local/state/theme-mode
